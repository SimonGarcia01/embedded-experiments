{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++ experiment",
            "type": "process",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${workspaceFolder}/cpp/iterators/find_if_lambda.cpp",
                "-o",
                "${workspaceFolder}/cpp/iterators/find_if_lambda.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}